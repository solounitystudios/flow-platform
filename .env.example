NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave unset (or "false") in every real deployment. Only set to
# "true" in local development to see lib/mock/* seed/demo fixtures (mock
# people on /p/[username], the dashboard's demo activity feed, etc). Never
# implied by NODE_ENV — must be turned on explicitly.
NEXT_PUBLIC_FLOW_DEMO_MODE=false

# Optional. Vector tile style URL for the live map (components/opportunities/LiveMap.tsx).
# Defaults to https://tiles.openfreemap.org/styles/liberty — a free, no-key,
# donation-supported basemap, fine for development but with no SLA. Point this
# at a provider with an SLA/support for production (e.g. a MapTiler or Stadia
# Maps style.json URL with your API key embedded, or a self-hosted style).
NEXT_PUBLIC_MAP_STYLE_URL=

# ── Passport Integration Gateway (server-only; NEVER prefix with NEXT_PUBLIC_) ──
# The gateway (app/api/passport/v2/*) is how Flow Creative Capture delivers
# evidence. Without BOTH values below it answers 503 not_configured — it never
# falls back to anything weaker.
#
# Service-role key: used ONLY by lib/passport/gateway to call the service_role-only
# passport_gateway_* RPCs. Never used anywhere else, never sent to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# JSON array of signing clients. Secrets >= 32 chars. Rotate by listing two keys for a
# client (new "active", old "retiring") and disabling the old one afterwards.
# scopes: capture_requests:read, capture_requests:report, evidence_packages:write, evidence:read
# PASSPORT_GATEWAY_CLIENTS=[{"client_id":"flow_capture","key_id":"k1","secret":"<generate: openssl rand -base64 48>","scopes":["capture_requests:read","capture_requests:report","evidence_packages:write","evidence:read"],"status":"active"}]
PASSPORT_GATEWAY_CLIENTS=
