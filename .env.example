NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave unset (or "false") in every real deployment. Only set to
# "true" in local development to see lib/mock/* seed/demo fixtures (mock
# people on /p/[username], the dashboard's demo activity feed, etc). Never
# implied by NODE_ENV — must be turned on explicitly.
NEXT_PUBLIC_FLOW_DEMO_MODE=false

# Optional. Vector tile style URL for the live map (components/opportunities/LiveMap.tsx).
# Defaults to https://tiles.openfreemap.org/styles/liberty — a free, no-key,
# donation-supported basemap, fine for development but with no SLA. Point this
# at a provider with an SLA/support for production (e.g. a MapTiler or Stadia
# Maps style.json URL with your API key embedded, or a self-hosted style).
NEXT_PUBLIC_MAP_STYLE_URL=
